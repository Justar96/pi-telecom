{
	"name": "@justar_96/pi-telecom",
	"version": "0.4.2",
	"description": "Telecom for pi: parallel pi agents in the same project see each other, talk, claim work, and get told when a peer changes a file they depend on.",
	"license": "MIT",
	"author": "Justar96",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Justar96/pi-telecom.git"
	},
	"homepage": "https://github.com/Justar96/pi-telecom#readme",
	"bugs": {
		"url": "https://github.com/Justar96/pi-telecom/issues"
	},
	"type": "module",
	"main": "src/index.ts",
	"keywords": [
		"pi-package",
		"pi-extension",
		"multi-agent",
		"ipc",
		"coordination"
	],
	"files": [
		"src/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"engines": {
		"node": ">=22.6"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "node scripts/test.mjs",
		"e2e": "node scripts/e2e-rpc.mjs",
		"e2e:live": "node scripts/e2e-live.mjs",
		"e2e:cache": "node scripts/e2e-cache.mjs",
		"e2e:matrix": "node scripts/e2e-matrix.mjs",
		"screenshots": "node scripts/screenshots/capture.mjs",
		"check": "npm run typecheck && npm test && npm run e2e",
		"prepublishOnly": "npm run typecheck && npm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@types/node": "^22.19.0",
		"typebox": "^1.1.38",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
